#!/bin/bash
# Read-only status collector for the "Keyboard Remapper" bar-widget plugin.
# Prints one JSON object describing whether keyd is installed/active, and
# whether the live /etc/keyd config matches the given expected-conf file.
# Never mutates anything.
#
# The expected-conf file is rendered by Panel.qml from the current rule
# catalog + toggle state -- this script has no idea what a "rule" is, it
# just diffs two files, so it never needs updating when rules.json changes.
#
# Usage: check-keyd-status <expected-conf-path>

source "$(dirname "${BASH_SOURCE[0]}")/keyd-remapper-lib.sh"

expected_path="${1:?usage: check-keyd-status <expected-conf-path>}"

keyd_present="false"
if command -v keyd >/dev/null 2>&1; then
  keyd_present="true"
fi

keyd_active="false"
if systemctl is-active --quiet keyd 2>/dev/null; then
  keyd_active="true"
fi

expected=""
if [[ -f $expected_path ]]; then
  expected="$(cat "$expected_path")"
fi

# The live side is the whole managed set (global file + any per-device
# scope files), concatenated in LC_ALL=C filename order -- the same order
# the renderer emits chunks in, so a byte-diff is meaningful. Scope-marker
# comment lines are stripped from BOTH sides before diffing: they carry no
# semantics, and a live set written by an older plugin version (pre-marker
# format) must not read as drifted when the rules are unchanged.
# Only files of the exact shapes the apply script generates count as
# managed -- a hand-made houz42-keyboard-remapper_notes.conf must not
# become permanent drift.
shopt -s nullglob
managed=()
for f in "/etc/keyd/$KEYD_REMAPPER_CONF_NAME" "/etc/keyd/${KEYD_REMAPPER_CONF_PREFIX}_"*.conf; do
  [[ -e $f ]] || continue
  base="$(basename "$f")"
  if [[ $base != "$KEYD_REMAPPER_CONF_NAME" && ! $base =~ ^${KEYD_REMAPPER_CONF_PREFIX}_[0-9a-fA-F]{4}:[0-9a-fA-F]{4}(\+[0-9a-fA-F]{4}:[0-9a-fA-F]{4})*\.conf$ ]]; then
    continue
  fi
  managed+=("$f")
done
actual=""
if ((${#managed[@]})); then
  actual="$(printf '%s\n' "${managed[@]}" | LC_ALL=C sort | xargs cat)"
fi

strip_markers() {
  grep -v '^### houz42-keyboard-remapper scope: ' || true
}
expected="$(printf '%s' "$expected" | strip_markers)"
actual="$(printf '%s' "$actual" | strip_markers)"

drift="false"
if [[ $actual != "$expected" ]]; then
  drift="true"
fi

jq -nc \
  --argjson keydPresent "$keyd_present" \
  --argjson keydActive "$keyd_active" \
  --argjson drift "$drift" \
  --arg confPath "$KEYD_REMAPPER_CONF" \
  '{keydPresent: $keydPresent, keydActive: $keydActive, drift: $drift, confPath: $confPath}'
