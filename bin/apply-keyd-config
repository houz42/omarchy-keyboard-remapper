#!/bin/bash
# Privileged apply step for the "Keyboard Remapper" bar-widget plugin.
# Invoked as: pkexec <this-script> <path-to-a-pending-conf-file>
# The pending conf is pre-rendered by the non-privileged QML/JS side; this
# script never receives rule text on argv and never runs a caller-supplied
# shell string -- its own body is the only thing pkexec elevates.
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/keyd-remapper-lib.sh"

pending="${1:?usage: apply-keyd-config <pending-conf-path>}"

# Refuse anything outside the plugin's own state dir, even though pkexec
# already fixes which script runs -- belt-and-suspenders against a stray
# caller passing an unexpected path.
case "$pending" in
  "$KEYD_REMAPPER_STATE_DIR"/*) ;;
  *)
    echo "apply-keyd-config: refusing path outside $KEYD_REMAPPER_STATE_DIR: $pending" >&2
    exit 1
    ;;
esac
[[ -f $pending ]] || { echo "apply-keyd-config: no such file: $pending" >&2; exit 1; }

# Install a dedicated polkit action for this script so the auth dialog
# shows OUR description instead of generic exec text. NOTE: auth_admin_keep
# does NOT reduce prompts here -- polkit keys the retained authorization
# to the pkexec process subject (pid+start-time), and every apply is a
# new process, so retention never carries across applies (verified live:
# the second of two quick toggles re-prompted). Burst prompt reduction is
# done by the debounce in Panel.qml instead. pkexec resolves the action
# from the binary path annotation, so the plugin's pkexec call is
# unchanged; baked with this script's own resolved path and rewritten if
# the plugin moves.
policy_id="com.houz42.keyboard-remapper.apply"
policy_file="/usr/share/polkit-1/actions/$policy_id.policy"
self_path="$(readlink -f "${BASH_SOURCE[0]}")"
read -r -d '' policy_wanted <<EOF || true
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <action id="$policy_id">
    <description>Apply keyboard-remapper keyd configuration</description>
    <message>Authentication is required to apply keyboard-remapper's keyd configuration</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">$self_path</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
EOF
if [[ ! -f $policy_file ]] || ! printf '%s\n' "$policy_wanted" | cmp -s - "$policy_file"; then
  printf '%s\n' "$policy_wanted" > "$policy_file.tmp"
  mv "$policy_file.tmp" "$policy_file"
fi

if ! command -v keyd >/dev/null 2>&1; then
  pacman -S --noconfirm --needed keyd
fi

# The pending file is a multi-scope blob rendered by Panel.qml: one chunk
# per device scope, each headed by a marker comment line
#   ### houz42-keyboard-remapper scope: <*|vid:pid|vid:pid+vid:pid>
# The marker is a keyd-ignored comment and is INSTALLED with its chunk, so
# the blob stays byte-identical to `cat` of the sorted live file set --
# which is exactly what check-keyd-status diffs, keeping that script
# rule-agnostic. The global scope keeps the legacy unsuffixed filename;
# device scopes sort after it, so keyd (lexical order, later wins) applies
# device-specific bindings over global ones.
workdir="$KEYD_REMAPPER_STATE_DIR/apply.$$"
mkdir -p "$workdir"
trap 'rm -rf "$workdir"' EXIT

declare -a chunk_names=()
current=""
while IFS= read -r line || [[ -n $line ]]; do
  if [[ $line =~ ^###\ houz42-keyboard-remapper\ scope:\ (.+)$ ]]; then
    scope="${BASH_REMATCH[1]}"
    if [[ $scope == "*" ]]; then
      name="$KEYD_REMAPPER_CONF_NAME"
    elif [[ $scope =~ ^[0-9a-f]{4}:[0-9a-f]{4}(\+[0-9a-f]{4}:[0-9a-f]{4})*$ ]]; then
      name="${KEYD_REMAPPER_CONF_PREFIX}_${scope}.conf"
    else
      echo "apply-keyd-config: malformed scope token in blob: $scope" >&2
      exit 1
    fi
    current="$workdir/$name"
    chunk_names+=("$name")
  fi
  [[ -n $current ]] || { echo "apply-keyd-config: blob does not start with a scope marker" >&2; exit 1; }
  printf '%s\n' "$line" >> "$current"
done < "$pending"

# Validate EVERY chunk with `keyd check` before touching the live set.
# `keyd check` exits non-zero on ANY warning, including the idiomatic
# "use layer(...) instead of assigning the modifier directly" note that
# plain map/swap rules produce ON PURPOSE (direct assignment is the
# correct XKB-parity translation). Those pass; every other diagnostic
# (e.g. "not a valid key or alias", which would silently drop the binding
# at load) refuses the apply instead of writing dead rules into /etc/keyd.
for name in "${chunk_names[@]}"; do
  if ! check_out="$(keyd check "$workdir/$name" 2>&1)"; then
    bad="$(printf '%s\n' "$check_out" | grep -vE '^[[:space:]]*(WARNING: .*: You should use layer\(|Parsing |No errors found|$)' || true)"
    if [[ -n $bad ]]; then
      jq -nc --arg err "$bad" --arg file "$name" '{ok: false, error: ("keyd config validation failed in " + $file + ": " + $err)}'
      exit 1
    fi
  fi
done

# keyd's stock unit has no Restart= directive at all, so a crash (keyd has
# known SIGSEGV bugs with some HID devices -- YubiKeys and multi-receiver
# dongles among them) leaves the service dead until something manually
# restarts it. Auto-restart so a crash self-heals in ~1s instead of
# silently breaking every configured remap until the next popup interaction.
keyd_dropin_dir="/etc/systemd/system/keyd.service.d"
keyd_dropin="$keyd_dropin_dir/houz42-keyboard-remapper-restart.conf"
if [[ ! -f $keyd_dropin ]]; then
  install -d -m755 "$keyd_dropin_dir"
  cat > "$keyd_dropin.tmp" <<'EOF'
[Service]
Restart=on-failure
RestartSec=1
EOF
  mv "$keyd_dropin.tmp" "$keyd_dropin"
  systemctl daemon-reload
fi

# Install the validated set, then prune stale managed files from earlier
# applies (renamed/removed scopes must not linger and keep matching
# devices). Only names this plugin itself generates are ever touched.
for name in "${chunk_names[@]}"; do
  install -Dm644 "$workdir/$name" "/etc/keyd/$name.tmp"
  mv "/etc/keyd/$name.tmp" "/etc/keyd/$name"
done

shopt -s nullglob
for existing in "/etc/keyd/$KEYD_REMAPPER_CONF_NAME" "/etc/keyd/${KEYD_REMAPPER_CONF_PREFIX}_"*.conf; do
  [[ -e $existing ]] || continue
  base="$(basename "$existing")"
  keep="false"
  for name in "${chunk_names[@]}"; do
    [[ $name == "$base" ]] && keep="true" && break
  done
  [[ $keep == "true" ]] || rm -f "$existing"
done

systemctl enable --now keyd
keyd reload 2>/dev/null || systemctl restart keyd

keyd_version="$(keyd -v 2>/dev/null | head -n1 || true)"
active="false"
if systemctl is-active --quiet keyd; then
  active="true"
fi

jq -nc \
  --argjson ok true \
  --argjson active "$active" \
  --arg version "$keyd_version" \
  --arg appliedPath "$KEYD_REMAPPER_CONF" \
  '{ok: $ok, active: $active, installedVersion: $version, appliedPath: $appliedPath}'
